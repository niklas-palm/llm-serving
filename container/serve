#!/usr/bin/env bash
# Entrypoint: start vLLM's OpenAI-compatible server with the configured flags.
#
# Runs the engine's own server directly with no wrapper. A shim in front would add a hop to every
# request and another component to keep compatible with the engine's API surface.
set -euo pipefail

PORT="${PORT:-8080}"

# /opt/model is a HOST directory shared by every task on this instance (see the task definition), so
# one copy of the weights is reused across restarts and across replicas. That is what stops a
# crash-looping task filling the disk with a fresh copy per attempt.
SHARED_CACHE="${SHARED_CACHE:-/opt/model}"
mkdir -p "${SHARED_CACHE}"

# Point the Hugging Face cache at the shared volume before anything can download. Without these, the
# hub cache defaults to ~/.cache/huggingface INSIDE the container: every task start writes its own
# multi-tens-of-GiB copy into the container's writable layer, a stopped container keeps that layer, and
# a crash-looping task fills the root volume.
export HF_HOME="${SHARED_CACHE}/hf"
export HUGGINGFACE_HUB_CACHE="${HF_HOME}/hub"
mkdir -p "${HUGGINGFACE_HUB_CACHE}"

# The engine's own cache (torch.compile artifacts, JIT-built kernels, autotune results, startup plan)
# goes on the same volume. Inside the container it is lost on every restart and rebuilt: measured
# 28 s of compilation and 81 s of model loading on a cold start against 0.1 s and 14 s with the cache
# on the host, so an engine restart on an existing instance is ready in ~50 s instead of ~3 min.
# Entries are keyed by engine version and configuration; a stale entry is ignored, not reused.
export VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT:-${SHARED_CACHE}/vllm}"
export VLLM_ENABLE_STARTUP_PLAN="${VLLM_ENABLE_STARTUP_PLAN:-1}"
# Two kernel compilers keep their own caches, by default in the container's home directory, so every start
# compiled again. Measured on DeepSeek-V4-Flash on H100s (vLLM 0.30.0): engine init 165 s with these caches
# empty, 62 s on the next start with them here (TileLang compiles skipped, JIT warmup 26.5 s -> 3.6 s).
export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-${SHARED_CACHE}/triton}"
export TILELANG_CACHE_DIR="${TILELANG_CACHE_DIR:-${SHARED_CACHE}/tilelang}"

ARGS=(
  # Also the served model name: /v1/models reports it and gateways route by it.
  --model "${MODEL_ID:?MODEL_ID is required}"
  --host 0.0.0.0
  --port "${PORT}"
  --tensor-parallel-size "${TENSOR_PARALLEL:-1}"
  --max-num-seqs "${MAX_NUM_SEQS:-256}"
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION:-0.95}"
  --kv-cache-dtype "${KV_CACHE_DTYPE:-fp8}"
)

# Both of these measured no effect across every value worth testing, so 0 means "do not pass the
# flag" and the engine picks. Passing a guessed value can only make things worse.
[[ "${MAX_MODEL_LEN:-0}" != "0" ]] && ARGS+=(--max-model-len "${MAX_MODEL_LEN}")
[[ "${MAX_NUM_BATCHED_TOKENS:-0}" != "0" ]] && ARGS+=(--max-num-batched-tokens "${MAX_NUM_BATCHED_TOKENS}")

# vLLM enables prefix caching by default, so only an explicit opt-out needs a flag. Off measured -1.2% on
# unique prompts and gives up the +46% to 2.7x that cached prompts get, so there is no reason to.
if [[ "${ENABLE_PREFIX_CACHING:-true}" == "false" ]]; then
  ARGS+=(--no-enable-prefix-caching)
fi

# Measured -13% decode in FP8 and +15% in bf16, so there is no right default - off unless asked.
if [[ "${ENABLE_EXPERT_PARALLEL:-false}" == "true" ]]; then
  ARGS+=(--enable-expert-parallel)
fi
# In-engine data parallelism: dp attention groups over their own batches, experts sharded across all
# tp x dp GPUs of this engine. The stack has already reserved tp x dp GPUs for the container.
if [[ "${DATA_PARALLEL:-1}" -gt 1 ]]; then
  ARGS+=(--data-parallel-size "${DATA_PARALLEL}")
fi

[[ -n "${QUANTIZATION:-}" ]] && ARGS+=(--quantization "${QUANTIZATION}")

# Tool calling: without a parser, a request that carries `tools` gets the model's tool-call text back as
# plain content and no client library recognises it. The parser is per model family (config.yaml).
[[ -n "${TOOL_CALL_PARSER:-}" ]] && ARGS+=(--enable-auto-tool-choice --tool-call-parser "${TOOL_CALL_PARSER}")
# Thinking models served with thinking on: move the chain of thought into reasoning_content.
[[ -n "${REASONING_PARSER:-}" ]] && ARGS+=(--reasoning-parser "${REASONING_PARSER}")

# Escape hatch for any flag this script does not model. Keeps the container useful without a rebuild
# every time you want to try something.
# The variable is unset unless extraArgs is configured, and under `set -u` a pattern substitution on an
# unset variable aborts the script in bash 4 and 5 (only macOS's bash 3.2 tolerates it).
EXTRA_ARGS="${EXTRA_ARGS:-}"
if [[ -n "${EXTRA_ARGS//[[:space:]]/}" ]]; then
  # shlex, not shell word-splitting: quoted arguments with spaces survive, and a * is not a glob.
  # NUL-terminated so a newline inside a quoted value stays inside it and an empty last argument is
  # kept; a value shlex cannot parse stops the start, because silently starting without the flags is
  # how a fix appears not to work. Through a file, not a variable: bash variables cannot hold NUL.
  EXTRA_FILE=$(mktemp)
  if ! python3 -c 'import shlex, sys; sys.stdout.write("".join(a + "\0" for a in shlex.split(sys.argv[1])))' "${EXTRA_ARGS}" > "${EXTRA_FILE}"; then
    echo "[serve] extraArgs is not shell-parseable: ${EXTRA_ARGS}" >&2
    exit 1
  fi
  mapfile -d '' -t EXTRA < "${EXTRA_FILE}"
  rm -f "${EXTRA_FILE}"
  ARGS+=("${EXTRA[@]}")
fi

echo "[serve] vllm serve ${ARGS[*]}"
exec vllm serve "${ARGS[@]}"
